// Skema mengikuti PRD bagian 8. Nama kolom snake_case sesuai PRD.
// Tidak bisa ditulis di sini (ada di migrasi SQL): partial unique index one_head_per_kk
// dan CHECK 16 digit untuk nik / no_kk.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  ADMIN_RW
  KETUA_RT
  WARGA
}

enum UserStatus {
  MENUNGGU_VERIFIKASI
  AKTIF
  DITOLAK
  NONAKTIF
}

enum JenisKelamin {
  L
  P
}

enum Agama {
  ISLAM
  KRISTEN
  KATOLIK
  HINDU
  BUDDHA
  KONGHUCU
  LAINNYA
}

enum GolonganDarah {
  A
  B
  AB
  O
  TIDAK_TAHU
}

enum HubunganKeluarga {
  KEPALA_KELUARGA
  ISTRI
  SUAMI
  ANAK
  MENANTU
  CUCU
  ORANG_TUA
  MERTUA
  FAMILI_LAIN
  LAINNYA
}

enum StatusPerkawinan {
  BELUM_KAWIN
  KAWIN
  CERAI_HIDUP
  CERAI_MATI
}

enum StatusKependudukan {
  AKTIF
  PINDAH
  MENINGGAL
}

enum JenisPengajuan {
  UBAH_WARGA
  TAMBAH_ANGGOTA
  LAPOR_PINDAH
  LAPOR_MENINGGAL
}

enum StatusPengajuan {
  MENUNGGU
  DISETUJUI
  DITOLAK
  DIBATALKAN
}

model Wilayah {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  rw         String  @db.VarChar(3)
  rt         String  @db.VarChar(3)
  keterangan String?

  kartu_keluarga KartuKeluarga[]
  users          User[]

  @@unique([rw, rt])
  @@map("wilayah")
}

model RefPendidikan {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nama   String @unique
  urutan Int
  alias  Json   @default("[]")

  warga Warga[]

  @@map("ref_pendidikan")
}

model RefPekerjaan {
  id    String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nama  String @unique
  alias Json   @default("[]")

  warga Warga[]

  @@map("ref_pekerjaan")
}

model KategoriUsia {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nama          String
  usia_min      Int
  usia_maks     Int?
  jenis_kelamin JenisKelamin?
  urutan        Int

  @@map("kategori_usia")
}

model User {
  id             String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nama           String
  email          String     @unique
  no_hp          String?
  role           Role
  wilayah_id     String?    @db.Uuid
  rw             String?    @db.VarChar(3)
  warga_id       String?    @unique @db.Uuid
  status         UserStatus
  email_verified Boolean    @default(false)
  // Diwajibkan Better Auth; tidak dipakai aplikasi.
  image          String?
  created_at     DateTime   @default(now()) @db.Timestamptz()
  updated_at     DateTime   @updatedAt @db.Timestamptz()

  wilayah          Wilayah?        @relation(fields: [wilayah_id], references: [id])
  warga            Warga?          @relation(fields: [warga_id], references: [id])
  kartu_keluarga   KartuKeluarga[]
  pengajuan_dibuat Pengajuan[]     @relation("pengajuan_diajukan_oleh")
  pengajuan_proses Pengajuan[]     @relation("pengajuan_diproses_oleh")
  import_batches   ImportBatch[]
  activity_logs    ActivityLog[]
  sessions         Session[]
  accounts         Account[]

  @@map("users")
}

model KartuKeluarga {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  no_kk          String    @unique @db.Char(16)
  alamat         String
  wilayah_id     String    @db.Uuid
  desa_kelurahan String?
  kecamatan      String?
  kabupaten_kota String?
  provinsi       String?
  kode_pos       String?   @db.VarChar(5)
  created_by     String    @db.Uuid
  created_at     DateTime  @default(now()) @db.Timestamptz()
  updated_at     DateTime  @updatedAt @db.Timestamptz()
  deleted_at     DateTime? @db.Timestamptz()

  wilayah   Wilayah     @relation(fields: [wilayah_id], references: [id])
  pembuat   User        @relation(fields: [created_by], references: [id])
  warga     Warga[]
  pengajuan Pengajuan[]

  @@index([wilayah_id])
  @@map("kartu_keluarga")
}

model Warga {
  id                  String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kartu_keluarga_id   String             @db.Uuid
  nik                 String             @unique @db.Char(16)
  nama_lengkap        String             @db.VarChar(100)
  jenis_kelamin       JenisKelamin
  // Nullable agar data Excel lama bisa masuk; form tetap mewajibkan (PRD 8.1, 7.2).
  tempat_lahir        String?
  tanggal_lahir       DateTime           @db.Date
  agama               Agama?
  pendidikan_id       String?            @db.Uuid
  pekerjaan_id        String?            @db.Uuid
  golongan_darah      GolonganDarah?
  hubungan_keluarga   HubunganKeluarga
  status_perkawinan   StatusPerkawinan?
  status_kependudukan StatusKependudukan @default(AKTIF)
  tanggal_status      DateTime?          @db.Date
  created_at          DateTime           @default(now()) @db.Timestamptz()
  updated_at          DateTime           @updatedAt @db.Timestamptz()
  deleted_at          DateTime?          @db.Timestamptz()

  kartu_keluarga KartuKeluarga  @relation(fields: [kartu_keluarga_id], references: [id])
  pendidikan     RefPendidikan? @relation(fields: [pendidikan_id], references: [id])
  pekerjaan      RefPekerjaan?  @relation(fields: [pekerjaan_id], references: [id])
  akun           User?
  pengajuan      Pengajuan[]

  @@index([tanggal_lahir])
  @@index([pendidikan_id])
  @@index([pekerjaan_id])
  @@index([jenis_kelamin])
  @@index([kartu_keluarga_id])
  @@map("warga")
}

model Pengajuan {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kartu_keluarga_id String          @db.Uuid
  diajukan_oleh     String          @db.Uuid
  jenis             JenisPengajuan
  warga_id          String?         @db.Uuid
  data_lama         Json?
  data_baru         Json?
  catatan           String?
  status            StatusPengajuan @default(MENUNGGU)
  diproses_oleh     String?         @db.Uuid
  alasan_penolakan  String?
  diproses_at       DateTime?       @db.Timestamptz()
  created_at        DateTime        @default(now()) @db.Timestamptz()

  kartu_keluarga KartuKeluarga @relation(fields: [kartu_keluarga_id], references: [id])
  pengaju        User          @relation("pengajuan_diajukan_oleh", fields: [diajukan_oleh], references: [id])
  pemroses       User?         @relation("pengajuan_diproses_oleh", fields: [diproses_oleh], references: [id])
  warga          Warga?        @relation(fields: [warga_id], references: [id])

  @@index([status, kartu_keluarga_id])
  @@map("pengajuan")
}

model ImportBatch {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id        String   @db.Uuid
  nama_file      String
  status         String   @db.VarChar(20)
  total_baris    Int      @default(0)
  baris_berhasil Int      @default(0)
  baris_gagal    Int      @default(0)
  mapping        Json?
  errors         Json?
  created_at     DateTime @default(now()) @db.Timestamptz()

  user User @relation(fields: [user_id], references: [id])

  @@map("import_batches")
}

model ActivityLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Kosong untuk kejadian tanpa pengguna dikenal, misalnya login gagal.
  user_id    String?  @db.Uuid
  aksi       String
  entitas    String?
  entitas_id String?
  perubahan  Json?
  ip         String?  @db.VarChar(45)
  created_at DateTime @default(now()) @db.Timestamptz()

  user User? @relation(fields: [user_id], references: [id])

  @@map("activity_logs")
}

// Tabel pustaka Better Auth. Kata sandi disimpan di Account.password (bukan users.password_hash seperti PRD 8.1).
model Session {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  token     String   @unique
  expiresAt DateTime @db.Timestamptz()
  ipAddress String?
  userAgent String?
  userId    String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz()
  updatedAt DateTime @updatedAt @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId             String
  providerId            String
  userId                String    @db.Uuid
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz()
  refreshTokenExpiresAt DateTime? @db.Timestamptz()
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz()
  updatedAt             DateTime  @updatedAt @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz()
  createdAt  DateTime @default(now()) @db.Timestamptz()
  updatedAt  DateTime @updatedAt @db.Timestamptz()

  @@index([identifier])
  @@map("verification")
}
