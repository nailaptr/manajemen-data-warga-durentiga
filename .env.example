# Salin ke .env lalu isi. Jangan commit .env.
# Koneksi PostgreSQL (nilai lokal ada di docker-compose.yml).
DATABASE_URL=

# Rahasia sesi (min. 32 karakter): openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Kata sandi akun uji lokal (min. 12 karakter). Jangan dipakai di produksi.
SEED_DEV_PASSWORD=

# Email (produksi): kunci API Resend dan alamat pengirim yang sudah diverifikasi di Resend.
# Di development email hanya dicetak ke terminal.
RESEND_API_KEY=
EMAIL_DARI=
